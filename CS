package gra;

public class Glock18 extends Weapon implements IFireable, IModeSwitchable {
    private boolean burstMode = false;

    public Glock18() {
        super("Glock18", 200, 20);
    }

    @Override
    public void displayStats() {
        System.out.println("--- " + name + " ---");
        System.out.println("Cena: " + price + "$");
        System.out.println("Amunicja: " + currentAmmo + "/" + clipSize);
    }

    @Override
    public void shoot() {
        if (currentAmmo > 0) {
            currentAmmo--;
            System.out.println(name + ": Strzał!");
        } else {
            System.out.println(name + ": Click! (Brak amunicji)");
        }
    }

    @Override
    public void reload() {
        refillAmmo();
    }

    @Override
    public void switchMode() {
        burstMode = !burstMode;
        System.out.println(name + ": Zmiana trybu ognia");
    }
}
