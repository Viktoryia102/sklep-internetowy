package gra;

public class M4A1S extends Weapon implements IFireable, IModeSwitchable {
    private boolean silencerOn = true;

    public M4A1S() {
        super("M4A1S", 2900, 20);
    }

    @Override
    public void displayStats() {
        System.out.println("--- " + name + " ---");
        System.out.println("Cena: " + price + "$");
        System.out.println("Amunicja: " + currentAmmo + "/" + clipSize);
    }

    @Override
    public void shoot() {
        if (currentAmmo > 0) {
            currentAmmo--;
            System.out.println(name + ": Strzał!");
        } else {
            System.out.println(name + ": Click! (Brak amunicji)");
        }
    }

    @Override
    public void reload() {
        refillAmmo();
    }

    @Override
    public void switchMode() {
        silencerOn = !silencerOn;
        System.out.println(name + ": Tłumik " + (silencerOn ? "założony" : "zdjęty"));
    }
}
